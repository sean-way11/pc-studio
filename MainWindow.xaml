<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PC Studio — SiteWorksStudio" Width="1120" Height="760" MinWidth="850" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#031A35" Foreground="#EAFBFF" FontFamily="Golos Text, Segoe UI">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#082B4C"/><Setter Property="Foreground" Value="#EAFBFF"/><Setter Property="BorderBrush" Value="#236178"/><Setter Property="Padding" Value="18,13"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#00E6F5"/><Setter TargetName="border" Property="Background" Value="#0B3859"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#12516A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#00E6F5"/><Setter Property="Foreground" Value="#031A35"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderBrush" Value="#00E6F5"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#A7C8D9"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Name="tab" Background="#082B4C" BorderBrush="#236178" BorderThickness="1" CornerRadius="9,9,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="tab" Property="Background" Value="#00E6F5"/><Setter Property="Foreground" Value="#031A35"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tab" Property="BorderBrush" Value="#00E6F5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontFamily" Value="Geologica, Segoe UI"/><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#EAFBFF"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Description" TargetType="TextBlock"><Setter Property="Foreground" Value="#A7C8D9"/><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,20"/></Style>
 </Window.Resources>
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SITEWORKSSTUDIO  /  PC STUDIO" Foreground="#00E6F5" FontSize="12" FontWeight="Bold"/><TextBlock Text="Компьютер под контролем." FontFamily="Geologica, Segoe UI" FontSize="32" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Диагностика, восстановление и настройка Windows" Foreground="#A7C8D9" Margin="0,5,0,0" FontSize="15"/></StackPanel><Border Grid.Column="1" BorderBrush="#236178" BorderThickness="1" CornerRadius="14" Padding="16,8" VerticalAlignment="Top"><TextBlock Text="WINDOWS 10 / 11" Foreground="#65F4FF" FontWeight="Bold"/></Border></Grid>
  <TabControl Grid.Row="1" Background="#062344" BorderBrush="#236178" Padding="0">
   <TabItem Header="Обзор"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25"><TextBlock Text="Состояние устройства" Style="{StaticResource Heading}"/><TextBlock Text="Снимок текущей нагрузки и свободного пространства. Данные обновляются по кнопке." Style="{StaticResource Description}"/><Border Background="#082B4C" BorderBrush="#236178" BorderThickness="1" CornerRadius="16" Padding="20"><TextBox x:Name="Report" Height="250" Background="Transparent" BorderThickness="0" Foreground="#EAFBFF" FontSize="15" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Border><Button x:Name="Refresh" Content="Обновить диагностику  →" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Восстановление"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25"><TextBlock Text="Восстановление Windows" Style="{StaticResource Heading}"/><TextBlock Text="Встроенные средства Microsoft. Проверка не меняет файлы; восстановление может изменить системные файлы и требует подтверждения администратора." Style="{StaticResource Description}"/><Button x:Name="SfcCheck" Content="Проверить системные файлы  →   SFC /verifyonly"/><Button x:Name="SfcRepair" Content="Восстановить системные файлы  →   SFC /scannow"/><Button x:Name="DismCheck" Content="Проверить хранилище Windows  →   DISM /ScanHealth"/><Button x:Name="DismRepair" Content="Восстановить хранилище Windows  →   DISM /RestoreHealth"/><TextBlock Text="Результат будет показан в отдельном окне. Восстановление DISM может использовать Windows Update и интернет. Эти средства исправляют только поддерживаемые ими неполадки." Style="{StaticResource Description}" Margin="0,15,0,0"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Производительность"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25"><TextBlock Text="Настройка производительности" Style="{StaticResource Heading}"/><TextBlock Text="Открой встроенные средства и выбери подходящие настройки для своего компьютера." Style="{StaticResource Description}"/><Button Tag="ms-settings:startupapps" Content="Автозагрузка приложений  →"/><Button Tag="ms-settings:storagesense" Content="Память устройства и временные файлы  →"/><Button Tag="ms-settings:powersleep" Content="Питание и режим работы  →"/><Button Tag="taskmgr.exe" Content="Диспетчер задач  →"/><Button Tag="SystemPropertiesPerformance.exe" Content="Визуальные эффекты и быстродействие  →"/><Button Tag="ms-settings:windowsupdate" Content="Центр обновления Windows  →"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Внешний вид"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25"><TextBlock Text="Твой рабочий стол" Style="{StaticResource Heading}"/><TextBlock Text="Настрой Windows под себя: темы, цвета и читаемость." Style="{StaticResource Description}"/><Button Tag="ms-settings:personalization" Content="Темы и фон  →"/><Button Tag="ms-settings:colors" Content="Цвета и прозрачность  →"/><Button Tag="ms-settings:display" Content="Масштаб и разрешение  →"/><Button Tag="ms-settings:easeofaccess-display" Content="Размер текста и доступность  →"/><Button Tag="ms-settings:taskbar" Content="Панель задач  →"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="О программе"><ScrollViewer><StackPanel Margin="25"><TextBlock Text="PC Studio" Style="{StaticResource Heading}"/><TextBlock Text="Помощник для Windows 10 и 11 от SiteWorksStudio. Программа собирает локальные показатели и открывает встроенные системные инструменты. Диагностика не отправляет данные в интернет." Style="{StaticResource Description}"/><TextBlock Text="PC Studio не обещает исправить все ошибки и не заменяет диагностику оборудования. Доступность настроек зависит от версии Windows. Перед восстановлением Windows программа покажет подтверждение." Style="{StaticResource Description}"/></StackPanel></ScrollViewer></TabItem>
  </TabControl><TextBlock Grid.Row="2" Text="SITEWORKSSTUDIO  ·  PC STUDIO" Foreground="#A7C8D9" FontSize="11" Margin="0,16,0,0"/>
 </Grid>
</Window>
